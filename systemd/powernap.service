[Unit]
Description=PowerNap Linux power profile manager
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStart=/usr/local/bin/powernap --config /etc/powernap/powernap.conf run
Restart=on-failure
RestartSec=10
WatchdogSec=30
TimeoutStopSec=20
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/powernap -/sys/devices/system/cpu/cpufreq -/sys/class/drm -/sys/class/powercap
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
